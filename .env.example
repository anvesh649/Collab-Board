# Copy to .env (same folder) and fill in real values. Never commit .env.
# Real environment variables override anything in .env; see README "Configuration".

# --- Postgres (read by docker-compose.yaml, only when the volume is first created) ---
POSTGRES_DB=collabboard
POSTGRES_USER=collabboard
POSTGRES_PASSWORD=change-me

# --- API (validated at startup by apps/api/src/config/env.ts) ---
# development or test locally. Unset means production: JSON logs, no automatic localhost.
NODE_ENV=development
PORT=3000

# Must match the POSTGRES_* values above when using the Compose database.
DATABASE_URL=postgres://collabboard:change-me@127.0.0.1:5432/collabboard
# Empty scratch database for `make makemigrations-check`. Created by docker/postgres/init.sql.
SHADOW_DATABASE_URL=postgres://collabboard:change-me@127.0.0.1:5432/collabboard_shadow

# Hostnames this API answers to: comma-separated, no scheme or port (e.g. shop.com,.shop.com).
# Required when NODE_ENV=production; never use * in production. In development,
# localhost, 127.0.0.1 and [::1] are always allowed.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Logging ---
# trace, debug, info, warn, error or fatal. Defaults to info.
LOG_LEVEL=info
# console (readable, local) or json (production, log tools). Defaults to json.
LOG_FORMAT=console

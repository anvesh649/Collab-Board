# Copy to .env (same folder) and fill in real values. Never commit .env.
# Real environment variables override anything in .env; see README "Configuration".

# --- Postgres (read by docker-compose.yaml) ---
POSTGRES_DB=collabboard
POSTGRES_USER=collabboard
POSTGRES_PASSWORD=change-me

# --- Django (read by backend/config/settings.py) ---
# Must match the POSTGRES_* values above when using the Compose database.
DATABASE_URL=postgres://collabboard:change-me@127.0.0.1:5432/collabboard

# Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-with-a-generated-key

# true for local development only. Defaults to false when unset.
DJANGO_DEBUG=true

# Hostnames this site answers to: comma-separated, no scheme or port (e.g. shop.com,.shop.com).
# Required when DJANGO_DEBUG=false; never use * in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Logging ---
# DEBUG, INFO, WARNING or ERROR. Defaults to INFO.
DJANGO_LOG_LEVEL=INFO
# console (readable, local) or json (production, log tools). Defaults to json.
DJANGO_LOG_FORMAT=console
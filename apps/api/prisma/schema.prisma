// CollabBoard database schema. The connection URL lives in prisma.config.ts (Prisma 7).
// Rules Prisma's schema cannot express (CHECK constraints) are added by hand in the
// migration SQL; see prisma/migrations/*_init/migration.sql.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// An account. The login is the email, compared without regard to case: the app stores
/// it lowercased (UsersService) and a CHECK constraint rejects anything that is not, so
/// the plain unique index on `email` is effectively case-insensitive.
model User {
  /// UUIDv7, generated by PostgreSQL 18's uuidv7(): not guessable, time-ordered so the
  /// primary-key index stays compact, and set even for rows inserted with raw SQL.
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String    @unique @db.VarChar(254)
  /// argon2id hash. NULL means the account cannot log in with a password (SSO, invites).
  passwordHash String?   @map("password_hash")
  firstName    String    @default("") @map("first_name") @db.VarChar(150)
  lastName     String    @default("") @map("last_name") @db.VarChar(150)
  isActive     Boolean   @default(true) @map("is_active")
  isStaff      Boolean   @default(false) @map("is_staff")
  isSuperuser  Boolean   @default(false) @map("is_superuser")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("users")
}
